# Переменные окружения сервиса «Аудиоаналитики» (services/audio-analytics).
# В Coolify — вкладка Environment Variables ресурса; для запуска без Docker —
# скопировать в services/audio-analytics/.env. Настоящих значений в
# репозитории нет и быть не должно.

# --- Общее -------------------------------------------------------------------
# production — без страницы /docs; development — с ней и с CORS «*», если
# CORS_ORIGINS пуст.
ENVIRONMENT=production
# Внешний адрес сервиса. Из него строятся ссылки на файлы (плеер админки,
# архив обновления приложения) при STORAGE_BACKEND=local.
PUBLIC_URL=https://audio.base40.fit
# Адреса админки через запятую — им разрешены запросы из браузера.
CORS_ORIGINS=https://admin.base40.fit
# Подробность журнала: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO

# --- База портала --------------------------------------------------------------
# Та же база, что у админки (DATABASE_URL club40-admin): прямое подключение
# или пулер в режиме session, НЕ transaction — воркер держит транзакции и
# блокировки строк. Префикс можно любой из postgres:// / postgresql:// —
# сервис сам подставит драйвер.
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@ХОСТ:5432/postgres

# --- Хранилище -----------------------------------------------------------------
# local — файлы на диске контейнера, папка STORAGE_DIR (в Coolify —
# постоянное хранилище на /data); s3 — Cloudflare R2, MinIO и т. п.
STORAGE_BACKEND=local
STORAGE_DIR=/data
# Ключ подписи ссылок /files/… (обязателен при local). Длинная случайная
# строка: python3 -c "import secrets; print(secrets.token_urlsafe(48))".
# Смена ключа делает недействительными только уже выданные ссылки (живут
# PRESIGNED_URL_TTL_S) — плеер и приложение просто запросят новые.
FILES_URL_SECRET=
# Сколько секунд живёт ссылка на запись смены и на архив обновления.
PRESIGNED_URL_TTL_S=3600

# Только при STORAGE_BACKEND=s3:
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=audio-analytics
S3_REGION=auto

# --- Вход сотрудников из админки -------------------------------------------------
# Токен входа проверяет GoTrue: GET {SUPABASE_URL}/auth/v1/user. Права —
# функции базы (aa_has, aa_recording_visible). Секрет JWT сервису не нужен.
SUPABASE_URL=https://api.base40.fit
# Публичный anon-ключ (тот же, что VITE_SUPABASE_PUBLISHABLE_KEY админки).
SUPABASE_ANON_KEY=

# --- Приложение на ресепшене ---------------------------------------------------
# Ключ приложения записи: один на всю сеть, вшит в сборку приложения
# (тот же, что APP_KEY прежнего сервера — иначе приложения на стойках
# перестанут подключаться). Сгенерировать новый:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_KEY=
# Предел одного сегмента записи, МБ (пятиминутный кусок — около 1,2 МБ).
MAX_SEGMENT_MB=50

# --- Распознавание речи: ElevenLabs Scribe ------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2

# --- Модель: Anthropic Claude ----------------------------------------------------
ANTHROPIC_API_KEY=
# Stage 1 — деление смены на диалоги и итог дня, stage 2 — оценка по
# метрикам. Haiku 5.5 в 20 раз дешевле Sonnet 5. Если оценки по метрикам
# окажутся слабее, верните claude-sonnet-5 только в LLM_MODEL_STAGE2.
LLM_MODEL_STAGE1=claude-haiku-5-5
LLM_MODEL_STAGE2=claude-haiku-5-5
# Лимит ответа модели (размышления и ответ вместе). Ниже 16000 длинный блок
# сегментации обрезается, и смена уходит в ошибку.
LLM_MAX_TOKENS=16000
# Сегментация дня идёт блоками не длиннее этого числа символов транскрипта;
# режется только по паузам длиннее CONVERSATION_GAP_S.
LLM_STAGE1_BLOCK_CHARS=40000
# Все метрики диалога оцениваются одним запросом; инструкции метрик набираются
# в запрос до этого числа символов, остальные идут следующим запросом.
LLM_METRICS_BATCH_CHARS=60000
# Диалоги короче этого числа реплик по метрикам не оцениваются.
LLM_MIN_DIALOG_TURNS=4
# Оценивать ли по метрикам сервисные разговоры (перенос, оплата, расписание).
LLM_METRICS_ON_SERVICE=false

# --- Тарифы для подсчёта стоимости смены (USD) -----------------------------------------
# ASR — цена часа аудио. ЗНАЧЕНИЕ НИЖЕ ОРИЕНТИРОВОЧНОЕ: поставьте фактическое
# из своего тарифа ElevenLabs, иначе стоимость в админке будет врать
# убедительно выглядящими цифрами.
PRICE_ASR_PER_HOUR_USD=0.40
# LLM — тарифы моделей Claude вместе с ценой кэша заданы в коде
# (app/pipeline/cost.py). Эти два значения — цена за миллион токенов только
# для модели, которой там нет; по умолчанию прайс Sonnet 5.
PRICE_LLM_INPUT_PER_MTOK_USD=2.00
PRICE_LLM_OUTPUT_PER_MTOK_USD=10.00

# --- Разбор --------------------------------------------------------------------
# Порог речи Silero VAD (0–1) и минимальные длительности речи и тишины, мс.
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500
# Пауза длиннее этого (секунды) делит речь на отдельные разговоры.
CONVERSATION_GAP_S=30
# Срок хранения аудио, дней: старше — сегменты и склеенная запись стираются
# (раз в сутки), разбор и расшифровка остаются. 0 — не стирать.
AUDIO_RETENTION_DAYS=60
# Разбор, статус которого не менялся дольше этого (секунды), считается
# зависшим — счётчик в /api/staff/status (админка смотрит на aa_is_stale, 3 ч).
STALE_PROCESSING_S=10800

# --- Воркер ---------------------------------------------------------------------
# Как часто пустая очередь проверяется снова, с.
WORKER_POLL_INTERVAL_S=5
# Сигнал жизни воркера в aa_service_state, с.
WORKER_HEARTBEAT_S=30

# --- Только для переноса из прежнего проекта (python -m cli.import_legacy --copy-audio) ---
# Хранилище прежнего сервиса (Cloudflare R2), откуда копируются файлы.
OLD_S3_ENDPOINT_URL=
OLD_S3_ACCESS_KEY_ID=
OLD_S3_SECRET_ACCESS_KEY=
OLD_S3_BUCKET=audio-analytics
OLD_S3_REGION=auto

# --- Задаются образом (Dockerfile), менять не нужно ------------------------------------
# PORT=8000                                    — порт API в контейнере
# VAD_MODEL_PATH=/opt/models/silero_vad.onnx   — модель Silero VAD, скачана при сборке
# SOURCE_COMMIT                                — коммит сборки (Coolify), виден в /api/staff/status
